{
  "name": "vanillats-calculator",
  "version": "1.0.0",
  "description": "A vanilla TypeScript calculator with no frameworks or libraries",
  "main": "dist/index.js",
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "tsc && webpack --mode production",
    "watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:visual": "jest --testMatch='**/visual-regression/**/*.visual.test.js'",
    "test:visual:update": "jest --testMatch='**/visual-regression/**/*.visual.test.js' --updateSnapshot",
    "start": "npm run dev"
  },
  "keywords": [
    "calculator",
    "typescript",
    "vanilla",
    "no-framework"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.4.0",
    "jsdom": "^24.0.0",
    "puppeteer": "^22.4.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  }
}
